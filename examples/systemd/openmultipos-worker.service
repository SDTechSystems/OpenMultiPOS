[Unit]
Description=OpenMultiPOS local development background worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/openmultipos/bench
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bench worker --queue short,default,long --quiet
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
