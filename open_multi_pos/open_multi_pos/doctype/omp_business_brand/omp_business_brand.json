{
  "doctype": "DocType",
  "name": "OMP Business Brand",
  "module": "Open Multi POS",
  "autoname": "hash",
  "engine": "InnoDB",
  "field_order": [
    "display_name",
    "enabled",
    "company",
    "warehouse",
    "pos_profile",
    "printer_profile",
    "receipt_footer",
    "qr_url",
    "allowed_users"
  ],
  "fields": [
    {
      "fieldname": "display_name",
      "fieldtype": "Data",
      "label": "Nombre comercial",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Habilitado",
      "default": "1"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "label": "Entidad legal",
      "reqd": 1
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "options": "Warehouse",
      "label": "Almacén",
      "reqd": 1
    },
    {
      "fieldname": "pos_profile",
      "fieldtype": "Link",
      "options": "POS Profile",
      "label": "Perfil POS",
      "reqd": 1
    },
    {
      "fieldname": "printer_profile",
      "fieldtype": "Data",
      "label": "ID del perfil de impresora",
      "default": "generic-58",
      "reqd": 1
    },
    {
      "fieldname": "receipt_footer",
      "fieldtype": "Small Text",
      "label": "Pie del recibo"
    },
    {
      "fieldname": "qr_url",
      "fieldtype": "Data",
      "label": "URL HTTPS del QR comercial"
    },
    {
      "fieldname": "allowed_users",
      "fieldtype": "Table",
      "options": "OMP Brand User",
      "label": "Usuarios autorizados"
    }
  ],
  "track_changes": 1,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1
    },
    {
      "role": "Sales User",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
