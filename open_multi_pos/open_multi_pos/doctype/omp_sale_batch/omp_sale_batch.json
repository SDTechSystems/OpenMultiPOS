{
  "doctype": "DocType",
  "name": "OMP Sale Batch",
  "module": "Open Multi POS",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "actor",
      "label": "Usuario",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "request_id",
      "label": "Identificador de operación",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Huella de solicitud",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "request_json",
      "label": "Solicitud original",
      "fieldtype": "Long Text",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Estado",
      "fieldtype": "Select",
      "options": "Pending\nCompleted\nAbandoned",
      "default": "Pending"
    },
    {
      "fieldname": "receipt_json",
      "label": "Recibo guardado",
      "fieldtype": "Long Text"
    }
  ],
  "field_order": [
    "actor",
    "request_id",
    "payload_hash",
    "request_json",
    "status",
    "receipt_json"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    }
  ]
}
